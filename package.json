{
  "name": "ideaget",
  "version": "0.1.0",
  "description": "Research workbench plugin for DeepSeek Harness: local Zotero library reading (search/get/clean Markdown via PDF pipeline), reserved agent/write ports.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "zotero",
    "research"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./rag/ingest": {
      "types": "./lib/rag/ingest/index.d.ts",
      "default": "./lib/rag/ingest/index.js"
    },
    "./rag/graph": {
      "types": "./lib/rag/graph/index.d.ts",
      "default": "./lib/rag/graph/index.js"
    },
    "./rag/rag": {
      "types": "./lib/rag/rag/index.d.ts",
      "default": "./lib/rag/rag/index.js"
    },
    "./rag/router": {
      "types": "./lib/rag/router/index.d.ts",
      "default": "./lib/rag/router/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepare": "pnpm run build",
    "probe:zotero": "node scripts/probe-zotero.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dsh": "./node_modules/.bin/tsx --tsconfig=../deepseek-harness/tsconfig.json ../deepseek-harness/apps/cli/src/bin.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "pdfjs-dist": "~5.4.394",
    "undici": "^8.10.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}