# ideaget / DeepSeek Harness launch environment (invoking-directory .env is read
# by the launcher automatically; copy this file to .env and fill in your key).
#
# The default agent model is deepseek-v4-flash (agent-default-model provider
# deepseek-official); only the API key below is required.

# DeepSeek API key (required for any model-backed run).
DEEPSEEK_API_KEY=

# Optional overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com          # chat/completions endpoint base
# DEEPSEEK_SEARCH_BASE_URL=                            # web_search provider base (defaults with the key)
# DEEPSEEK_FILES_API_TIMEOUT=                          # files/attachments API timeout in ms
# DSH_TELEMETRY_DISABLED=1                             # hard opt-out of session telemetry

# ideaget plugin knobs (read by the plugin, defaults shown):
# IDEAGET_ZOTERO_API=http://127.0.0.1:23119/api        # local Zotero API base

# ── paper-RAG embedding (optional; BM25-only until configured) ──
# Local embedding via a runner endpoint (Ollama example), or via an
# OpenAI-compatible /embeddings service (vLLM/Infinity/tei) with the model
# files downloaded under your chosen models dir (see docs/09-embedding.md).
# 本地 OpenAI 兼容线路（vLLM/Infinity/TEI/Ollama）
# IDEAGET_EMBEDDING_PROVIDER=url
# IDEAGET_EMBEDDING_URL=http://127.0.0.1:8080/v1/embeddings
# IDEAGET_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ── Google Gemini Embedding（云端线路）──
# 与本地线路同一 embedTexts 契约：请求走 batchEmbedContents，向量按输入顺序
# 返回，下游余弦融合与结果与本地运行一致。
# IDEAGET_EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=                     # 或 GOOGLE_API_KEY（二选一）
# IDEAGET_GEMINI_MODEL=gemini-embedding-001
# IDEAGET_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
